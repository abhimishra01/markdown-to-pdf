---
import '../styles/doc.css';
const btn = 'inline-flex h-11 items-center justify-center gap-2 rounded-xl border border-edge bg-paper px-4 text-sm font-semibold text-ink transition-colors hover:border-brand focus-visible:outline-offset-2';
const field = 'block w-full h-11 rounded-xl border border-edge bg-paper px-3 text-sm font-medium text-ink outline-none focus:border-brand focus:ring-2 focus:ring-brand/30';
const lbl = 'mb-1 block text-xs font-semibold text-muted';
// preset: set by a landing page (sample text and options). The home page has none.
const { preset = null } = Astro.props;
---
<section id="tool" aria-label="Markdown to PDF converter" data-preset={preset ? JSON.stringify(preset) : undefined} class="rounded-2xl border border-line bg-card p-3 sm:p-5 shadow-[var(--card-shadow)]">
  <div class="flex flex-wrap items-center gap-2">
    <div id="md-dlbar" class="dl-bar order-first w-full sm:order-last sm:ml-auto sm:w-auto">
      <button type="button" id="md-download" class="inline-flex h-12 w-full items-center justify-center gap-2 rounded-xl bg-brand px-5 text-base font-bold text-white transition-colors hover:brightness-110 focus-visible:outline-offset-2 sm:w-auto aria-disabled:cursor-not-allowed aria-disabled:opacity-50">
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4v11M7 11l5 5 5-5M5 20h14"/></svg>
        Download PDF
      </button>
    </div>
    <button type="button" id="md-open" class={btn}>
      <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/></svg>
      Open .md file
    </button>
    <input type="file" id="md-file" accept=".md,.markdown,.mdown,.txt,text/markdown,text/plain" class="sr-only" tabindex="-1" aria-label="Choose a Markdown file" />
    <button type="button" id="md-sample" class={btn}>Load sample</button>
    <button type="button" id="md-sample-math" class={btn}>Diagram and math sample</button>
    <button type="button" id="md-toc" class={btn} title="Adds a linked list of your headings at the cursor">Insert contents</button>
    <button type="button" id="md-clear" class={btn}>Clear</button>
  </div>

  <!-- Option values must match PAPERS, MARGINS and SIZES in src/lib/markdown.js; the labels repeat their numbers. -->
  <details id="md-opts" open class="mt-3 group/opts">
  <summary class="flex h-11 cursor-pointer list-none items-center justify-between rounded-xl border border-edge bg-paper px-3 text-sm font-semibold [&::-webkit-details-marker]:hidden">Page options <svg class="h-4 w-4 shrink-0 text-muted transition-transform group-open/opts:rotate-180" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 6l5 5 5-5"/></svg></summary>
  <div role="group" aria-label="PDF options" class="mt-3 grid grid-cols-2 gap-x-3 gap-y-2 sm:grid-cols-3 lg:grid-cols-4">
    <div><label for="opt-theme" class={lbl}>Theme</label>
      <select id="opt-theme" class={field}><option value="clean">Clean</option><option value="classic">Classic (serif)</option><option value="technical">Technical</option></select></div>
    <div><label for="opt-paper" class={lbl}>Paper</label>
      <select id="opt-paper" class={field}><option value="letter">US Letter</option><option value="a4">A4</option></select></div>
    <div><label for="opt-orient" class={lbl}>Orientation</label>
      <select id="opt-orient" class={field}><option value="portrait">Portrait</option><option value="landscape">Landscape</option></select></div>
    <div><label for="opt-margin" class={lbl}>Margins</label>
      <select id="opt-margin" class={field}><option value="narrow">Narrow (0.5 in)</option><option value="normal" selected>Normal (0.75 in)</option><option value="wide">Wide (1 in)</option></select></div>
    <div><label for="opt-size" class={lbl}>Text size</label>
      <select id="opt-size" class={field}><option value="small">Small (10 pt)</option><option value="medium" selected>Medium (11 pt)</option><option value="large">Large (12 pt)</option></select></div>
    <div>
      <span class={lbl}>Page numbers</span>
      <label class="flex h-11 cursor-pointer items-center gap-3 rounded-xl border border-edge bg-paper px-3 text-sm font-medium">
        <input type="checkbox" id="opt-numbers" class="h-5 w-5 accent-[var(--brand)]" />
        <span>Add to footer</span>
      </label>
    </div>
    <div class="col-span-2 sm:col-span-1">
      <span class={lbl}>Front matter</span>
      <label class="flex h-11 cursor-pointer items-center gap-3 rounded-xl border border-edge bg-paper px-3 text-sm font-medium" title="Front matter is the block between the --- lines at the top. It is hidden unless you turn this on.">
        <input type="checkbox" id="opt-fm" class="h-5 w-5 accent-[var(--brand)]" />
        <span>Print as a table</span>
      </label>
    </div>
  </div>
  </details>
  <script is:inline>if (matchMedia('(max-width: 639px)').matches) document.getElementById('md-opts').open = false;</script>

  <p class="mt-3 flex min-h-[1.5rem] flex-wrap items-center gap-x-3 gap-y-1 text-sm text-muted">
    <span id="md-count"></span>
    <span id="md-msg" role="status" aria-live="polite"></span>
    <button type="button" id="md-undo" hidden class="rounded-md px-2 py-1 font-semibold text-brand-ink underline underline-offset-2">Undo</button>
  </p>

  <div class="mt-1 grid gap-3 lg:grid-cols-2">
    <div class="min-w-0">
      <label for="md-input" class="mb-1 block text-sm font-semibold">Markdown <span class="font-normal text-muted">(type, paste, or drop a .md file)</span></label>
      <textarea id="md-input" spellcheck="false" autocomplete="off" autocapitalize="off" placeholder="# Paste your Markdown here"
        class="block h-72 w-full resize-none rounded-xl border border-edge bg-paper p-3 font-mono text-[13px] leading-relaxed text-ink outline-none focus:border-brand focus:ring-2 focus:ring-brand/30 sm:h-[30rem] lg:h-[40rem]"></textarea>
    </div>
    <div class="min-w-0">
      <h2 id="md-preview-h" class="mb-1 text-sm font-semibold">Preview <span class="font-normal text-muted">(what the PDF will look like)</span></h2>
      <div id="md-scroll" tabindex="0" role="region" aria-labelledby="md-preview-h"
        class="h-96 overflow-auto rounded-xl border border-line bg-[#e6e4de] p-2 [scrollbar-gutter:stable] dark:bg-[#0a0a0c] sm:h-[30rem] sm:p-3 lg:h-[40rem]">
        <div id="md-sheet" class="mx-auto bg-white p-5 shadow-[0_1px_8px_rgba(0,0,0,.18)] sm:p-8">
          <div id="md-doc" class="md-doc theme-clean"></div>
        </div>
      </div>
    </div>
  </div>

  <p class="mt-3 text-sm text-muted">
    The button opens your browser print dialog. Choose <strong class="text-ink">Save as PDF</strong> as the destination. For a clean page, turn off "Headers and footers". The file is named after your first heading. Everything stays on your device.
  </p>
  <details class="mt-2 text-sm text-muted">
    <summary class="cursor-pointer font-semibold text-ink">Saving a PDF on a phone or tablet</summary>
    <div class="mt-2 grid gap-3 sm:grid-cols-2">
      <div>
        <p class="font-semibold text-ink">iPhone and iPad (Safari)</p>
        <ol class="mt-1 list-decimal space-y-1 pl-5">
          <li>Press Download PDF.</li>
          <li>On the page preview, spread two fingers apart. The PDF opens full screen.</li>
          <li>Tap the Share button, then Save to Files.</li>
        </ol>
      </div>
      <div>
        <p class="font-semibold text-ink">Android (Chrome)</p>
        <ol class="mt-1 list-decimal space-y-1 pl-5">
          <li>Press Download PDF.</li>
          <li>At the top of the print screen, set Destination to Save as PDF.</li>
          <li>Tap the round PDF button and choose where to save.</li>
        </ol>
      </div>
    </div>
  </details>
  <dialog id="md-tip" aria-labelledby="md-tip-h" class="m-auto w-[min(92vw,30rem)] rounded-2xl border border-line bg-card p-5 text-ink shadow-[var(--card-shadow)] backdrop:bg-black/50">
    <h2 id="md-tip-h" class="text-lg font-bold">Two settings for a clean PDF</h2>
    <p class="mt-2 text-sm text-muted">Your browser opens its print window next. In that window:</p>
    <figure class="mt-3 select-none">
    <figcaption class="mb-1.5 text-xs font-semibold uppercase tracking-wide text-muted">Picture of the print window (not clickable)</figcaption>
    <svg viewBox="0 0 320 128" class="pointer-events-none w-full rounded-lg border border-dashed border-line bg-paper opacity-80" role="img" aria-label="A print window with Destination set to Save as PDF and Headers and footers turned off">
      <rect x="12" y="10" width="296" height="108" rx="8" fill="none" stroke="currentColor" stroke-opacity=".3"/>
      <text x="26" y="36" font-size="11" fill="currentColor" fill-opacity=".6" font-family="system-ui, sans-serif">Destination</text>
      <rect x="110" y="22" width="180" height="22" rx="5" fill="var(--brand-soft)" stroke="var(--brand)" stroke-width="2"/>
      <text x="120" y="37" font-size="11" font-weight="700" fill="currentColor" font-family="system-ui, sans-serif">Save as PDF</text>
      <text x="26" y="82" font-size="11" fill="currentColor" fill-opacity=".6" font-family="system-ui, sans-serif">Options</text>
      <rect x="110" y="68" width="14" height="14" rx="3" fill="none" stroke="var(--brand)" stroke-width="2"/>
      <text x="132" y="80" font-size="11" font-weight="700" fill="currentColor" font-family="system-ui, sans-serif">Headers and footers (off)</text>
      <rect x="110" y="92" width="14" height="14" rx="3" fill="none" stroke="currentColor" stroke-opacity=".4"/>
      <text x="132" y="104" font-size="11" fill="currentColor" fill-opacity=".6" font-family="system-ui, sans-serif">Background graphics (optional)</text>
    </svg>
    </figure>
    <ol class="mt-3 list-decimal space-y-1 pl-5 text-sm">
      <li>Set <strong>Destination</strong> to <strong>Save as PDF</strong>.</li>
      <li>Turn off <strong>Headers and footers</strong>.</li>
    </ol>
    <label class="mt-4 flex cursor-pointer items-center gap-3 text-sm"><input type="checkbox" id="md-tip-off" class="h-5 w-5 accent-[var(--brand)]" /> <span>Do not show this again</span></label>
    <div class="mt-4 flex flex-wrap justify-end gap-2">
      <button type="button" id="md-tip-cancel" class={btn}>Cancel</button>
      <button type="button" id="md-tip-go" class="inline-flex h-11 items-center justify-center rounded-xl bg-brand px-5 text-sm font-bold text-white hover:brightness-110">Open the print window</button>
    </div>
  </dialog>
  <noscript><p class="mt-3 rounded-lg bg-brand-soft p-3 text-sm">This tool needs JavaScript to convert Markdown.</p></noscript>
  <div id="print-root" aria-hidden="true"></div>
  <div class="h-20 sm:hidden" aria-hidden="true"></div>
</section>

<style is:global>
  /* Phones: the Download button sticks to the bottom while the tool is on screen. */
  @media (max-width: 639px) {
    .dl-bar { position: fixed; left: 0; right: 0; bottom: 0; z-index: 15; padding: .75rem 1rem calc(.75rem + env(safe-area-inset-bottom)); background: color-mix(in srgb, var(--paper) 94%, transparent); border-top: 1px solid var(--line); backdrop-filter: blur(8px); }
    .dl-bar[data-off] { display: none; }
  }
  /* Narrow preview: wide tables scroll sideways instead of squeezing every word. */
  .preview-narrow #md-doc table { display: block; overflow-x: auto; max-width: 100%; }
  /* A table wider than the sheet scrolls inside the preview. The PDF lets the table grow to the page. */
  #md-sheet { overflow-x: auto; }
  :root[data-theme="dark"] #md-sheet { filter: brightness(.93); }
</style>

<script>
  import DOMPurify from 'dompurify';
  import { tryRender, makeSanitizer, buildPageCss, estimatePages, docStats, pdfTitle, buildToc, needsMath, needsMermaid, pageInches, initialText, diagramScale, LEGIBLE_SCALE, MARGINS, SIZES, SAMPLE, SAMPLE_MATH, PAPERS } from '../lib/markdown.js';
  import { enhance, markLongCode, softWrapTableCode, fitDiagrams } from '../lib/enhance.js';

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const input = $<HTMLTextAreaElement>('md-input');
  const doc = $('md-doc'), sheet = $('md-sheet'), scroller = $('md-scroll');
  const countEl = $('md-count'), msgEl = $('md-msg'), undoBtn = $<HTMLButtonElement>('md-undo');
  const dl = $<HTMLButtonElement>('md-download'), dlBar = $('md-dlbar');
  const fileInput = $<HTMLInputElement>('md-file');
  const opt = {
    theme: $<HTMLSelectElement>('opt-theme'), paper: $<HTMLSelectElement>('opt-paper'),
    margin: $<HTMLSelectElement>('opt-margin'), size: $<HTMLSelectElement>('opt-size'),
    orient: $<HTMLSelectElement>('opt-orient'),
    numbers: $<HTMLInputElement>('opt-numbers'), fm: $<HTMLInputElement>('opt-fm'),
  };
  let preset: any = null;
  try { preset = JSON.parse($('tool').dataset.preset || 'null'); } catch {}
  const sanitize = makeSanitizer(DOMPurify);
  const KEY = 'mdpdf:v1';
  const MAX_CHARS = 5_000_000;
  let failed = false;          // the last render did not work: never print stale output
  let sampleShown = false;     // the box still holds an untouched sample
  let renderTimer = 0, measureTimer = 0, undoTimer = 0, undoText = '';

  const say = (text: string) => { msgEl.textContent = text; };

  // The @page rule lives in its own style element so print uses the chosen paper and margins.
  const pageStyle = document.createElement('style');
  pageStyle.id = 'page-css';
  document.head.appendChild(pageStyle);

  function load() {
    let saved: any = null;
    try { saved = JSON.parse(localStorage.getItem(KEY) || 'null'); } catch {}
    const pick = (el: HTMLSelectElement, v: unknown) => { if (typeof v === 'string' && [...el.options].some((o) => o.value === v)) el.value = v; };
    if (saved) {
      pick(opt.theme, saved.theme); pick(opt.paper, saved.paper); pick(opt.margin, saved.margin); pick(opt.size, saved.size);
      pick(opt.orient, saved.orient); opt.numbers.checked = !!saved.numbers; opt.fm.checked = !!saved.fm;
    }
    // A landing page sets its own options. Its sample replaces the default sample, never the visitor's own text.
    if (preset) {
      for (const k of ['theme', 'paper', 'margin', 'size', 'orient'] as const) if (preset[k]) pick(opt[k], preset[k]);
      if (typeof preset.numbers === 'boolean') opt.numbers.checked = preset.numbers;
      if (typeof preset.fm === 'boolean') opt.fm.checked = preset.fm;
    }
    // A landing page opens on its own sample unless the visitor has typed their own text.
    const text = initialText(saved, preset?.sample, SAMPLE);
    sampleShown = text === SAMPLE || text === SAMPLE_MATH || text === preset?.sample;
    input.value = text;
  }
  function save() {
    try {
      localStorage.setItem(KEY, JSON.stringify({ text: input.value, theme: opt.theme.value, paper: opt.paper.value, margin: opt.margin.value, size: opt.size.value, orient: opt.orient.value, numbers: opt.numbers.checked, fm: opt.fm.checked, sample: sampleShown }));
    } catch {}
  }
  const settings = () => ({ paper: opt.paper.value, margin: opt.margin.value, pageNumbers: opt.numbers.checked, landscape: opt.orient.value === 'landscape' });

  // Preview sheet: on wide screens it has the real printable width, scaled down to fit, so line breaks match the PDF.
  // On narrow screens (phones) it fills the width and wide tables scroll.
  let lastScale = '';
  function layoutSheet() {
    const m = MARGINS[opt.margin.value as keyof typeof MARGINS];
    const cs = getComputedStyle(scroller);
    const avail = scroller.clientWidth - parseFloat(cs.paddingLeft) - parseFloat(cs.paddingRight);
    const pageW = pageInches(opt.paper.value, settings().landscape).w * 96;
    const wide = avail >= 480;
    scroller.classList.toggle('preview-narrow', !wide);
    if (!wide) {
      sheet.style.width = ''; sheet.style.padding = ''; sheet.style.zoom = ''; lastScale = '';
      return;
    }
    const scale = Math.min(1, avail / pageW).toFixed(3);
    sheet.style.width = pageW + 'px';
    sheet.style.padding = m * 96 + 'px';
    if (scale !== lastScale) { sheet.style.zoom = scale; lastScale = scale; }
  }

  // Page count: lay the same HTML out at the real printable width in a hidden box and measure it.
  const meter = document.createElement('div');
  meter.setAttribute('aria-hidden', 'true');
  meter.style.cssText = 'position:absolute;left:-99999px;top:0;visibility:hidden;pointer-events:none';
  document.body.appendChild(meter);
  meter.addEventListener('load', () => scheduleMeasure(100), true); // images change the height when they arrive
  function measurePages() {
    const m = MARGINS[opt.margin.value as keyof typeof MARGINS];
    meter.style.width = (pageInches(opt.paper.value, settings().landscape).w - 2 * m) * 96 + 'px';
    meter.innerHTML = `<div class="${doc.className}" style="--doc-pt:${doc.style.getPropertyValue('--doc-pt')}">${doc.innerHTML.replace(/\sid="[^"]*"/g, '')}</div>`;
    return estimatePages(meter.offsetHeight, settings());
  }

  function updateCount() {
    if (failed) { countEl.textContent = ''; return; }
    const s = docStats(input.value);
    if (s.empty) { countEl.textContent = 'Nothing to convert yet. Paste or type some Markdown.'; return; }
    const pages = measurePages();
    const words = `${s.words.toLocaleString('en-US')} ${s.words === 1 ? 'word' : 'words'}`;
    countEl.textContent = pages ? `${words}, about ${pages} ${pages === 1 ? 'page' : 'pages'} (${PAPERS[opt.paper.value as keyof typeof PAPERS].label}).` : `${words}.`;
  }
  function scheduleMeasure(delay = 300) { clearTimeout(measureTimer); measureTimer = window.setTimeout(updateCount, delay); }

  // Wide diagrams are drawn to the printable width. When that makes the text small, suggest landscape.
  function fitHint() {
    const m = MARGINS[opt.margin.value as keyof typeof MARGINS];
    const avail = (pageInches(opt.paper.value, settings().landscape).w - 2 * m) * 96;
    const scale = fitDiagrams(doc, avail);
    if (scale < LEGIBLE_SCALE && opt.orient.value !== 'landscape') say('A wide diagram is scaled down to fit. Set Orientation to Landscape to print it larger.');
    else if (msgEl.textContent?.startsWith('A wide diagram')) say('');
  }

  function render() {
    clearTimeout(renderTimer); renderTimer = 0;
    doc.className = `md-doc theme-${opt.theme.value}`;
    doc.style.setProperty('--doc-pt', SIZES[opt.size.value as keyof typeof SIZES] + 'pt');
    pageStyle.textContent = buildPageCss(settings());
    layoutSheet();
    const text = input.value;
    failed = false;
    if (text.trim() === '') {
      doc.innerHTML = '<p class="md-empty">Your preview appears here.</p>';
    } else if (text.length > MAX_CHARS) {
      failed = true;
      doc.innerHTML = '<p class="md-error">This text is over 5 MB, which is more than the preview can show. Split it into smaller files.</p>';
    } else {
      const r = tryRender(text, sanitize, { showFrontMatter: opt.fm.checked });
      if (r.ok) {
        doc.innerHTML = r.html;
        markLongCode(doc); softWrapTableCode(doc);
        // Math and diagrams load their code only when the document has some.
        if (needsMath(r.html) || needsMermaid(r.html)) enhance(doc, () => { markLongCode(doc); fitHint(); scheduleMeasure(50); });
      }
      else {
        failed = true;
        doc.innerHTML = '<p class="md-error">The preview could not be built from this text. It may be nested too deeply. Remove the last thing you added and try again.</p>';
      }
    }
    if (failed) say('The text could not be converted.'); else if (msgEl.textContent === 'The text could not be converted.') say('');
    dl.setAttribute('aria-disabled', String(failed || text.trim() === ''));
    scheduleMeasure();
  }

  // Typing waits a moment so large documents do not rebuild on every key. Option changes apply at once.
  function scheduleRender() {
    clearTimeout(renderTimer);
    renderTimer = window.setTimeout(() => { render(); save(); }, input.value.length > 200_000 ? 500 : 150);
  }
  const applyNow = () => { render(); save(); };
  input.addEventListener('input', () => { sampleShown = false; hideUndo(); scheduleRender(); });
  Object.values(opt).forEach((el) => el.addEventListener('change', applyNow));
  // Save a pending edit when the page closes. An untouched landing page must not overwrite the visitor's saved options with its own.
  window.addEventListener('pagehide', () => { if (renderTimer) save(); });
  new ResizeObserver(() => layoutSheet()).observe(scroller);

  // Heading and footnote links stay inside the preview; other links never replace the editor.
  doc.addEventListener('click', (e) => {
    const a = (e.target as HTMLElement).closest('a[href]') as HTMLAnchorElement | null;
    if (!a) return;
    const href = a.getAttribute('href')!;
    if (/^(https?:|mailto:|tel:)/i.test(href)) return; // external links open in a new tab
    e.preventDefault();
    if (!href.startsWith('#')) return;
    if (hiddenIds.length) afterPrint(); // a print dialog that never reported back
    let id = href.slice(1);
    try { id = decodeURIComponent(id); } catch {}
    const t = doc.querySelector(`[id="${CSS.escape(id)}"]`);
    if (t) scroller.scrollTop += t.getBoundingClientRect().top - scroller.getBoundingClientRect().top - 8;
  });

  // Replacing the text: keep one copy so Undo can bring it back.
  function hideUndo() { clearTimeout(undoTimer); undoBtn.hidden = true; }
  function replaceText(next: string, note = '') {
    const prev = input.value;
    if (prev.trim() !== '' && prev !== next) {
      undoText = prev; undoBtn.hidden = false;
      clearTimeout(undoTimer); undoTimer = window.setTimeout(hideUndo, 20000);
    }
    input.value = next;
    sampleShown = next === SAMPLE || next === SAMPLE_MATH;
    applyNow();
    say(note);
  }
  undoBtn.addEventListener('click', () => {
    input.value = undoText; sampleShown = false; hideUndo(); applyNow(); scroller.scrollTop = 0; say('Your text is back.'); input.focus();
  });

  // Files: button, picker and drag and drop.
  async function readFile(f: File | undefined) {
    if (!f) return;
    if (f.size > MAX_CHARS) { say('That file is over 5 MB. Try a smaller one.'); return; }
    if (!/\.(md|markdown|mdown|mkd|txt)$/i.test(f.name) && !f.type.startsWith('text/')) { say('That does not look like a Markdown or text file.'); return; }
    let text = '';
    try { text = await f.text(); } catch { say('The file could not be read.'); return; }
    if (text.includes('\u0000')) { say('That file is not plain text.'); return; }
    replaceText(text, `Opened ${f.name}.`);
    scroller.scrollTop = 0;
  }
  $('md-open').addEventListener('click', () => fileInput.click());
  fileInput.addEventListener('change', () => { readFile(fileInput.files?.[0]); fileInput.value = ''; });
  input.addEventListener('dragover', (e) => { e.preventDefault(); input.classList.add('border-brand'); });
  input.addEventListener('dragleave', () => input.classList.remove('border-brand'));
  input.addEventListener('drop', (e) => { e.preventDefault(); input.classList.remove('border-brand'); readFile(e.dataTransfer?.files?.[0]); });
  // A file dropped anywhere else must not make the browser leave the page.
  window.addEventListener('dragover', (e) => e.preventDefault());
  window.addEventListener('drop', (e) => e.preventDefault());
  $('md-sample').addEventListener('click', () => { replaceText(SAMPLE); input.focus(); });
  $('md-sample-math').addEventListener('click', () => { replaceText(SAMPLE_MATH); input.focus(); });

  // Insert contents: a linked list of the headings, at the cursor.
  $('md-toc').addEventListener('click', () => {
    const toc = buildToc(input.value);
    if (!toc) { say('Add some headings first. A heading is a line that starts with ## and a space.'); input.focus(); return; }
    const pos = input.selectionStart ?? 0;
    const before = input.value.slice(0, pos);
    const lead = before === '' || before.endsWith('\n\n') ? '' : before.endsWith('\n') ? '\n' : '\n\n';
    const text = `${lead}## Contents\n\n${toc}\n`;
    input.focus();
    if (!document.execCommand || !document.execCommand('insertText', false, text)) { // insertText keeps the browser undo
      input.setRangeText(text, pos, input.selectionEnd ?? pos, 'end');
      input.dispatchEvent(new Event('input', { bubbles: true }));
    }
    say('Contents added at the cursor. Headings added later need a new list.');
  });
  $('md-clear').addEventListener('click', () => { replaceText(''); input.focus(); });

  // Printing: copy the rendered document into #print-root; CSS hides everything else.
  const root = $('print-root');
  document.body.appendChild(root); // must be a direct child of body: print CSS hides every other child
  const pageTitle = document.title;
  let hiddenIds: [Element, string][] = [];
  function preparePrint() {
    if (renderTimer) render(); // a keystroke is still waiting: print what is in the box
    const copy = doc.cloneNode(true) as HTMLElement;
    copy.removeAttribute('id');
    copy.querySelectorAll('details').forEach((d) => d.setAttribute('open', '')); // closed sections would print as one line
    while (copy.lastElementChild?.classList.contains('md-pagebreak')) copy.lastElementChild.remove(); // no blank last page
    // The hidden preview must not own the heading ids, or links in the PDF would point at it.
    hiddenIds = [...doc.querySelectorAll('[id]')].map((el) => [el, el.id] as [Element, string]);
    hiddenIds.forEach(([el]) => el.removeAttribute('id'));
    root.replaceChildren(copy);
    document.title = pdfTitle(input.value); // browsers use the page title as the PDF file name
  }
  function afterPrint() {
    hiddenIds.forEach(([el, id]) => el.setAttribute('id', id)); hiddenIds = [];
    root.replaceChildren();
    document.title = pageTitle;
  }
  window.addEventListener('beforeprint', () => { if (!hiddenIds.length) preparePrint(); });
  window.addEventListener('afterprint', afterPrint);
  const touch = matchMedia('(pointer: coarse)').matches;
  const tip = $<HTMLDialogElement>('md-tip'), TIP_KEY = 'mdpdf:notip';
  const tipHidden = () => { try { return localStorage.getItem(TIP_KEY) === '1'; } catch { return false; } };
  function startPrint() {
    say(touch ? 'Follow the steps under "Saving a PDF on a phone or tablet" below.' : 'In the print dialog, choose "Save as PDF" as the destination.');
    if (!hiddenIds.length) preparePrint();
    window.print();
  }
  dl.addEventListener('click', () => {
    if (input.value.trim() === '') { say('Add some Markdown first, then download.'); input.focus(); return; }
    if (renderTimer) render();
    if (failed) { say('Fix the text first. The preview could not be built.'); return; }
    // On a computer the first click explains the two print settings. "Do not show again" skips it for good.
    if (!touch && !tipHidden() && typeof tip.showModal === 'function') { tip.showModal(); return; }
    startPrint();
  });
  $<HTMLInputElement>('md-tip-off').addEventListener('change', (e) => { try { (e.target as HTMLInputElement).checked ? localStorage.setItem(TIP_KEY, '1') : localStorage.removeItem(TIP_KEY); } catch {} });
  $('md-tip-cancel').addEventListener('click', () => tip.close());
  tip.addEventListener('click', (e) => { // a click on the dark backdrop closes the tip
    const r = tip.getBoundingClientRect();
    if (e.target === tip && (e.clientX < r.left || e.clientX > r.right || e.clientY < r.top || e.clientY > r.bottom)) tip.close();
  });
  $('md-tip-go').addEventListener('click', () => {
    if ($<HTMLInputElement>('md-tip-off').checked) { try { localStorage.setItem(TIP_KEY, '1'); } catch {} }
    tip.close();
    startPrint();
  });

  // Phones: show the sticky Download bar only while the tool is on screen and the keyboard is closed.
  let toolVisible = true, typing = false;
  const syncBar = () => dlBar.toggleAttribute('data-off', !toolVisible || typing);
  new IntersectionObserver(([e]) => { toolVisible = e.isIntersecting; syncBar(); }).observe($('tool'));
  input.addEventListener('focus', () => { typing = true; syncBar(); });
  input.addEventListener('blur', () => { typing = false; syncBar(); });

  load();
  render();
</script>
