---
import site from '../site.config.ts';
import ThemeToggle from './ThemeToggle.astro';
import { url, routePath } from '../lib/url.ts';
const path = routePath(Astro.url.pathname);
const links = [
  { href: '/', label: 'Tool', hideSmall: true },
  { href: '/about/', label: 'About' },
  { href: '/contact/', label: 'Contact' },
];
---
<header class="sticky top-0 z-20 border-b border-line bg-paper/90 backdrop-blur">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-4">
    <a href={url('/')} class="flex items-center gap-2.5 whitespace-nowrap font-bold tracking-tight text-ink no-underline">
      <img src={url('favicon.svg')} alt="" width="28" height="28" class="h-7 w-7 rounded-lg" />
      <span>{site.name}</span>
    </a>
    <div class="flex items-center gap-1">
      <nav aria-label="Main" class="flex items-center">
        {links.map((l) => (
          <a href={url(l.href)} aria-current={path === l.href ? 'page' : undefined}
            class={`inline-flex min-h-11 items-center rounded-full px-3 text-sm font-medium text-muted no-underline hover:text-ink aria-[current=page]:text-ink aria-[current=page]:bg-brand-soft max-[420px]:px-2 ${(l as any).hideSmall ? 'max-[420px]:hidden' : ''}`}>{l.label}</a>
        ))}
      </nav>
      <ThemeToggle />
    </div>
  </div>
</header>
